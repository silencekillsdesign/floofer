# Copy this file to .env, fill in the keys you have, and restart the dev server.

# ---------------------------------------------------------------- Supabase --
# Postgres + Auth + photo storage. Create a project at https://supabase.com,
# then Project Settings -> API for both values.
#   URL      = "Project URL"
#   ANON KEY = "anon / public" key. Safe to ship to the browser: every table
#              is protected by row-level security (supabase/migrations/0001).
# Apply the schema once:  npx supabase link --project-ref <ref> && npx supabase db push
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Server-only. Bypasses row-level security -- never expose to the client, and
# never commit a real value. Only needed for the org-seeding script
# (`npm run seed:org`), which is how shelters get invited during the pilot.
SUPABASE_SERVICE_KEY=

# ------------------------------------------------------------------ Email --
# Delivers adopter messages and play-date requests to shelters. Without it the
# app still works: requests are saved and the UI says plainly that nothing was
# emailed, rather than showing a tick for a message nobody received.
#   1. Sign up at https://resend.com (free: 3,000/month, 100/day)
#   2. Verify a domain you own — required to email anyone but yourself
#   3. Create an API key
NUXT_RESEND_API_KEY=

# Must be on the domain verified above, or Resend refuses the send.
NUXT_MAIL_FROM="Floofer <notifications@yourdomain.com>"

# RescueGroups.org v5 API key — the only API with real euthanasia-risk fields.
# Request one (free, read-only) at:
# https://rescuegroups.org/services/adoptable-pet-data-api/
NUXT_RESCUEGROUPS_API_KEY=

# Public site URL — used for Open Graph share cards and canonical links.
# Set this to your real Netlify URL so shared dog links preview correctly.
NUXT_PUBLIC_SITE_URL=

# Optional: error monitoring. Leave blank to keep Sentry inert.
NUXT_PUBLIC_SENTRY_DSN=

# Petfinder v2 API — largest adoptable-pet inventory, great media.
# Get instantly at https://www.petfinder.com/developers/ ("Get an API Key"):
# the "API Key" is the client id, plus its Secret.
NUXT_PETFINDER_API_KEY=
NUXT_PETFINDER_SECRET=
